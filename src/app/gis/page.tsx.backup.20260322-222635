    try {
      const params = new URLSearchParams({
        min_lat: String(b.min_lat), max_lat: String(b.max_lat),
        min_lng: String(b.min_lng), max_lng: String(b.max_lng),
      });
      const res = await fetch(`/api/gis/household-connections?${params}`);
